{
    "name": "requests",
    "description": "HTTP client library, inspired by python-requests",
    "copyright": "Copyright © 2016, igor",
    "authors": ["ikod"],
    "license": "BSL-1.0",
    "sourcePaths": ["source"],
    "importPaths": ["source"],
    "dependencies": {
        "automem": "==0.6.11",
        "cachetools": "==1.0.1"
    },
    "configurations": [
        {
            "name": "openssl-dynamic"
        },
        {
            "name": "openssl-static",
            "platforms": ["windows", "linux"],
            "versions": ["RequestsOpenSSLStatic"],
            "libs-windows": ["libssl", "libcrypto", "ws2_32", "gdi32", "advapi32", "crypt32", "user32"],
            "libs-linux": [":libssl.a", ":libcrypto.a", "dl", "pthread"],
            "lflags-linux": ["--exclude-libs=libssl.a:libcrypto.a"]
        }
    ],
    "buildTypes": {
        "debug": {
            "buildOptions": ["debugMode", "debugInfo"],
            "dflags-dmd": ["-debug=requests", "-g"],
            "dflags-ldc": ["-d-debug=requests"]
        },
        "unittest": {
            "buildOptions": ["unittests", "debugMode", "debugInfo"],
            "debugVersions": ["requests"]
        }
    }
}
