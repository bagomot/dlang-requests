{
	"name": "tls-tests",
	"description": "TLS tests of requests against local servers, run with dub test",
	"license": "BSL-1.0",
	"targetType": "library",
	"dependencies": {
		"requests": {
			"path": "../.."
		}
	},
	"configurations": [
		{
			"name": "openssl-dynamic",
			"subConfigurations": {
				"requests": "openssl-dynamic"
			}
		},
		{
			"name": "openssl-static",
			"platforms": ["windows", "linux"],
			"subConfigurations": {
				"requests": "openssl-static"
			},
			"versions": ["RequestsOpenSSLStatic"],
			"lflags-windows": ["/LIBPATH:$OPENSSL_LIB_DIR"],
			"lflags-linux": ["-L$OPENSSL_LIB_DIR"],
			"libs-linux": ["curl"]
		}
	]
}
